   "layout": "title",
   "eyebrow": "Physics in Tamil",
   "title": "Projectile **motion**",
   "subtitle": "How things fly",
   "accent": "mint"
  },
  {
   "id": "s2",
   "start": 4,
   "end": 8,
   "layout": "question",
   "question": "Why does a thrown ball **curve**?",
   "answer": "Gravity pulls it down while it keeps moving forward"
  },
  {
   "id": "s3",
   "start": 8,
   "end": 12,
   "layout": "equation",
   "eyebrow": "The idea",
   "title": "Two motions, one path",
   "tex": "y = x\\tan\\theta - \\frac{g x^2}{2 v_0^2 \\cos^2\\theta}",
   "size": "l",
   "note": "Sideways speed stays the same. Only the up-and-down speed changes."
  },
  {
   "id": "s4",
   "start": 12,
   "end": 17,
   "layout": "derivation",
   "title": "Range of the throw",
   "lines": [
    {
     "tex": "R = v_x \\, t",
     "note": "sideways speed times time"
    },
    {
     "tex": "t = \\frac{2 v_0 \\sin\\theta}{g}",
     "note": "time in the air"
    },
    {
     "tex": "R = \\frac{v_0^2 \\sin 2\\theta}{g}",
     "note": "put them together"
    }
   ]
  },
  {
   "id": "s5",
   "start": 17,
   "end": 23,
   "layout": "sim",
   "sim": "projectile",
   "eyebrow": "Try it",
